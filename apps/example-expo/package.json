{
  "main": "expo-router/entry",
  "name": "example-expo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "expo prebuild --clean",
    "start": "expo start",
    "ete:disable": "pnpm uninstall react-native-edge-to-edge || true",
    "ete:enable": "expo install react-native-edge-to-edge",
    "android": "expo run:android",
    "android:clean": "rm -rf .expo && rm -rf android && pnpm android",
    "ios": "expo run:ios",
    "ios:clean": "rm -rf .expo && rm -rf ios && pnpm ios",
    "ios:deep-clean": "source ./scripts/deep-clean-ios.sh",
    "reset-project": "node ./scripts/reset-project.js",
    "typecheck": "tsc",
    "lint": "expo lint && eslint",
    "format": "prettier",
    "check": "pnpm typecheck && prettier --write . && expo lint --fix && eslint --fix",
    "epc": "tsx scripts/expo-packages-check.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@react-native-vector-icons/ant-design": "^14.0.0",
    "@react-native-vector-icons/material-design-icons": "^14.0.0",
    "@shopify/flash-list": "2.3.2",
    "@the-sheet/embedded-stack-navigator": "workspace:*",
    "@the-sheet/flash-list-v2": "workspace:*",
    "@the-sheet/keyboard-controller": "workspace:*",
    "@the-sheet/the-sheet": "workspace:*",
    "@the-sheet/universe-portal": "workspace:*",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@react-native/eslint-config": "^0.88.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@types/semver": "^7.8.0",
    "eslint": "^10.13.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
