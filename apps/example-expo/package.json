{
  "main": "expo-router/entry",
  "name": "example-expo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "expo prebuild --clean",
    "start": "expo start",
    "ete:disable": "pnpm uninstall react-native-edge-to-edge || true",
    "ete:enable": "expo install react-native-edge-to-edge",
    "android": "expo run:android",
    "android:clean": "rm -rf .expo && rm -rf android && pnpm android",
    "ios": "expo run:ios",
    "ios:clean": "rm -rf .expo && rm -rf ios && pnpm ios",
    "reset-project": "node ./scripts/reset-project.js",
    "typecheck": "tsc",
    "lint": "expo lint && eslint",
    "format": "prettier",
    "check": "pnpm typecheck && prettier --write . && expo lint --fix && eslint --fix",
    "epc": "tsx scripts/expo-packages-check.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@faker-js/faker": "^10.4.0",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/elements": "^2.9.18",
    "@react-navigation/native": "^7.2.4",
    "expo": "~55.0.15",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.34",
    "expo-font": "~55.0.7",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.10",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.8",
    "expo-system-ui": "~55.0.18",
    "expo-web-browser": "~55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-embedded-stack-navigator": "workspace:*",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-keyboard-controller": "1.21.7",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-the-sheet": "workspace:*",
    "react-native-universe-portal": "workspace:*",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@react-native/eslint-config": "^0.85.3",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.14",
    "@types/semver": "^7.7.1",
    "eslint": "^10.3.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.2",
    "semver": "^7.7.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
